# ---------- 后端配置 ----------
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://192.168.2.121:3000"]

# Dify API配置（使用远程服务器上的Dify）
DIFY_API_KEY=app-uIVSkmrE5tyhUjfwGylWfncg
