DATABASE_PORT=31102
DATABASE_NAME=icoastline
DATABASE_USER=icoastline
DATABASE_PASSWORD=icoastline

# ---------- 后端配置 ----------
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Dify API配置（使用服务器上的Dify）
DIFY_API_KEY=app-uIVSkmrE5tyhUjfwGylWfncg
DIFY_BASE_URL=http://localhost:8080

# ---------- OnlyOffice配置（使用服务器上的OnlyOffice） ----------
ONLYOFFICE_DOC_SERVER_URL=http://localhost:8080
ONLYOFFICE_SECRET=patentwriter_jwt_secret_2026
