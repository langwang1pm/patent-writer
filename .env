# ============================================
# Patent Writer 环境变量配置
# 使用场景：本地离线（localhost）
# ============================================

# ---------- 数据库配置（使用服务器上已有的PostgreSQL） ----------
# 完整连接串（优先使用）
DATABASE_URL=postgresql://icoastline:icoastline@host.docker.internal:31102/icoastline
DATABASE_HOST=host.docker.internal
DATABASE_PORT=31102
DATABASE_NAME=icoastline
DATABASE_USER=icoastline
DATABASE_PASSWORD=icoastline

# ---------- 后端配置 ----------
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Dify API配置（使用服务器上的Dify）
# PatentWriter-Agent（已经不用了）
# DIFY_API_KEY=app-uIVSkmrE5tyhUjfwGylWfncg
# PatentWriter-Agent_chatflow
DIFY_API_KEY=app-fL18lw6uaffDQhgvd2hUulCu
DIFY_BASE_URL=http://host.docker.internal:80

# 注意：知识库操作需要使用 Dataset API Key（以 dataset- 开头）设置为：DIFY_KNOWLEDGE_API_KEY
# 请替换为你在 Dify 控制台获取的 Dataset API Key
# DIFY_API_KEY=dataset-YOUR_DATASET_API_KEY_HERE

DIFY_KNOWLEDGE_ID=06c4e1be-523b-453d-b53e-30e42085fd9e
DIFY_KNOWLEDGE_API_KEY=dataset-FPexjNsYAVV1aQZC9l5XMqtp


# ---------- OnlyOffice配置（使用服务器上的OnlyOffice） ----------
ONLYOFFICE_DOC_SERVER_URL=http://host.docker.internal:8080
ONLYOFFICE_SECRET=patentwriter_jwt_secret_2026
ONLYOFFICE_CALLBACK_URL=http://host.docker.internal:8002/api/onlyoffice/callback

# ---------- 前端配置 ----------
VITE_API_BASE_URL=http://localhost:8002

# ---------- Docker Compose配置 ----------
COMPOSE_PROJECT_NAME=patent-writer
BACKEND_PORT=8002
FRONTEND_PORT=3000
