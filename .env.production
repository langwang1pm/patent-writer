# ============================================
# Patent Writer 生产环境配置
# 使用场景：Docker Compose 部署
# ============================================

# ---------- 数据库配置（使用宿主机上的PostgreSQL） ----------
DATABASE_HOST=host.docker.internal
DATABASE_PORT=31102
DATABASE_NAME=icoastline
DATABASE_USER=icoastline
DATABASE_PASSWORD=icoastline
DATABASE_URL=postgresql://icoastline:icoastline@host.docker.internal:31102/icoastline

# ---------- 后端配置 ----------
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8002"]

# Dify API配置（使用宿主机上的Dify）
DIFY_API_KEY=app-uIVSkmrE5tyhUjfwGylWfncg
DIFY_BASE_URL=http://host.docker.internal:80

# ---------- OnlyOffice配置（使用宿主机上的OnlyOffice） ----------
ONLYOFFICE_DOC_SERVER_URL=http://host.docker.internal:8080
ONLYOFFICE_SECRET=patentwriter_jwt_secret_2026
ONLYOFFICE_CALLBACK_URL=http://host.docker.internal:8002/api/onlyoffice/callback

# ---------- 前端配置 ----------
# VITE_API_BASE_URL 是浏览器端访问后端的地址（构建时注入到JS中）
# 用户从本机访问时用 localhost，从其他机器访问时用宿主机IP
VITE_API_BASE_URL=http://localhost:8002

# ---------- Docker Compose配置 ----------
COMPOSE_PROJECT_NAME=patent-writer
BACKEND_PORT=8002
FRONTEND_PORT=3000