# ============================================
# Patent Writer 环境变量配置模板
# 复制此文件为 .env 并填写真实值
# ============================================

# ---------- 数据库配置 ----------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=your_database_name
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password

# ---------- 后端配置 ----------
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Dify API配置
DIFY_API_KEY=your_dify_api_key
DIFY_BASE_URL=http://localhost:8080

# 注意：知识库操作需要使用 Dataset API Key（以 dataset- 开头）设置为：DIFY_KNOWLEDGE_API_KEY
# 请替换为你在 Dify 控制台获取的 Dataset API Key
# DIFY_API_KEY=dataset-YOUR_DATASET_API_KEY_HERE

DIFY_KNOWLEDGE_ID=bad40f9b-36f8-4079-827c-cb1e67ccddb2
DIFY_KNOWLEDGE_API_KEY=dataset-FPexjNsYAVV1aQZC9l5XMqtp

# ---------- OnlyOffice配置 ----------
ONLYOFFICE_DOC_SERVER_URL=http://localhost:8080
ONLYOFFICE_SECRET=your_onlyoffice_jwt_secret
ONLYOFFICE_CALLBACK_URL=http://localhost:8000/api/onlyoffice/callback

# ---------- 前端配置 ----------
VITE_API_BASE_URL=http://localhost:8000

# ---------- Docker Compose配置 ----------
COMPOSE_PROJECT_NAME=patent-writer
BACKEND_PORT=8000
FRONTEND_PORT=3000
